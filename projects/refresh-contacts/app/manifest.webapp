{
  "name": "Refresh Contacts",
  "description": "Fast contacts manager with search, favorites, speed dial and vCard export",
  "version": "0.1.0",
  "type": "privileged",
  "origin": "app://refresh-contacts",
  "launch_path": "/index.html",
  "developer": {
    "name": "Atlas Messenger",
    "url": "https://github.com/theatlasteam/rstore-apps"
  },
  "permissions": {
    "contacts": {
      "access": "readwrite"
    }
  },
  "orientation": "portrait",
  "chrome": {
    "statusbar": "overlap"
  },
  "default_locale": "en-US",
  "locales": {
    "ru": {
      "name": "Refresh Контакты",
      "description": "Быстрая книга контактов с поиском, избранным и экспортом vCard"
    }
  },
  "csp": "default-src 'self'; script-src 'self'; style-src 'self' app://theme.gaiamobile.org; img-src 'self'; object-src 'none'",
  "icons": {
    "56": "/icons/icon-56.png",
    "112": "/icons/icon-112.png",
    "128": "/icons/icon-128.png"
  }
}
