{
  "name": "Refresh AI",
  "description": "Lightweight AI chat assistant for OpenAI, OpenRouter, Groq and local LLMs",
  "version": "0.1.0",
  "type": "privileged",
  "origin": "app://refresh-ai",
  "launch_path": "/index.html",
  "developer": {
    "name": "Atlas Messenger",
    "url": "https://github.com/theatlasteam/rstore-apps"
  },
  "permissions": {
    "systemXHR": {}
  },
  "orientation": "portrait",
  "chrome": {
    "statusbar": "overlap"
  },
  "default_locale": "en-US",
  "locales": {
    "ru": {
      "name": "Refresh AI",
      "description": "Лёгкий ИИ-ассистент для OpenAI, OpenRouter, Groq и локальных моделей"
    }
  },
  "csp": "default-src 'self'; script-src 'self'; style-src 'self' app://theme.gaiamobile.org; img-src 'self'; connect-src *; object-src 'none'",
  "icons": {
    "56": "/icons/icon-56.png",
    "112": "/icons/icon-112.png",
    "128": "/icons/icon-128.png"
  }
}
