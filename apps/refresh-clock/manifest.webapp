{
  "name": "Refresh Clock",
  "description": "World clock, lap stopwatch and countdown timer with presets",
  "version": "0.1.0",
  "type": "privileged",
  "origin": "app://refresh-clock",
  "launch_path": "/index.html",
  "developer": {
    "name": "Atlas Messenger",
    "url": "https://github.com/theatlasteam/rstore-apps"
  },
  "permissions": {},
  "orientation": "portrait",
  "chrome": {
    "statusbar": "overlap"
  },
  "default_locale": "en-US",
  "locales": {
    "ru": {
      "name": "Refresh Часы",
      "description": "Мировое время, секундомер с кругами и таймер обратного отсчёта"
    }
  },
  "csp": "default-src 'self'; script-src 'self'; style-src 'self' app://theme.gaiamobile.org; img-src 'self'; object-src 'none'",
  "icons": {
    "56": "/icons/icon-56.png",
    "112": "/icons/icon-112.png",
    "128": "/icons/icon-128.png"
  }
}
