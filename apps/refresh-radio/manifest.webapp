{
  "name": "Refresh Radio",
  "description": "Ad-free internet radio player with curated streams and custom stations",
  "version": "0.1.0",
  "type": "privileged",
  "origin": "app://refresh-radio",
  "launch_path": "/index.html",
  "developer": {
    "name": "Atlas Messenger",
    "url": "https://github.com/theatlasteam/rstore-apps"
  },
  "permissions": {
    "audio-channel-content": {}
  },
  "orientation": "portrait",
  "chrome": {
    "statusbar": "overlap"
  },
  "default_locale": "en-US",
  "locales": {
    "ru": {
      "name": "Refresh Радио",
      "description": "Интернет-радио без рекламы с подборкой станций и своими потоками"
    }
  },
  "csp": "default-src 'self'; script-src 'self'; style-src 'self' app://theme.gaiamobile.org; img-src 'self'; media-src *; object-src 'none'",
  "icons": {
    "56": "/icons/icon-56.png",
    "112": "/icons/icon-112.png",
    "128": "/icons/icon-128.png"
  }
}
